@tool
class_name _SweetUIGenerator
extends EditorScript

## Sweet UI's profile for the NodeWrapper generator. Keeps the static API the plugin, README and
## tests use; generation itself lives in addons/_lib/node_wrapper.

const Generator = preload("res://addons/_lib/node_wrapper/src/generator.gd")
const Profile = preload("res://addons/_lib/node_wrapper/src/profile.gd")

const TARGETS_SETTING = "sweet_ui/generation/targets"
const LEGACY_DIRECTORY_SETTING = "sweet_ui/generation/directory"
const DEFAULT_DIRECTORY = "res://scripts/sweet_ui"
## Templates use this placeholder; each target renames it to its own class name.
const DEFAULT_NAME = "SweetUI"
const DEFAULT_TARGETS = {DEFAULT_DIRECTORY: DEFAULT_NAME}
const UNNAMED_ALIAS = "_SweetUI"
const SOURCE = DEFAULT_DIRECTORY + "/sweet_ui_source.gd"
const TARGET = DEFAULT_DIRECTORY + "/generated/sweet_ui.gd"
const CLASSES_TARGET = DEFAULT_DIRECTORY + "/generated/sweets_generated.gd"
const SWEETS_TARGET = DEFAULT_DIRECTORY + "/generated/sweets.gd"


func _run() -> void:
	generate()


static func register_setting() -> void:
	if not ProjectSettings.has_setting(TARGETS_SETTING):
		var legacy = ProjectSettings.get_setting(LEGACY_DIRECTORY_SETTING, DEFAULT_DIRECTORY)
		ProjectSettings.set_setting(TARGETS_SETTING, {str(legacy): DEFAULT_NAME})
	if ProjectSettings.has_setting(LEGACY_DIRECTORY_SETTING):
		ProjectSettings.set_setting(LEGACY_DIRECTORY_SETTING, null)
	_generator().register_setting()


static func _template_path(name: String) -> String:
	var script: Script = _SweetUIGenerator
	return script.resource_path.get_base_dir().path_join("templates/" + name + ".gd.txt")


static func read_template() -> String:
	return FileAccess.get_file_as_string(_template_path("sweet_ui"))


## Built per call so template edits apply without reloading the plugin.
static func _generator() -> Generator:
	var script: Script = _SweetUIGenerator
	var profile = Profile.new()
	profile.label = "Sweet UI"
	profile.prefix = "Sw"
	profile.owner_name = DEFAULT_NAME
	profile.owner_alias = UNNAMED_ALIAS
	profile.header = "# Generated by _SweetUIGenerator. Do not edit."
	profile.alias_prefix = "_SweetTarget"
	profile.targets_setting = TARGETS_SETTING
	profile.default_targets = DEFAULT_TARGETS
	profile.addon_dir = script.resource_path.get_base_dir().get_base_dir().get_base_dir()
	profile.source_file = "sweet_ui_source.gd"
	profile.owner_file = "generated/sweet_ui.gd"
	profile.classes_file = "generated/sweets_generated.gd"
	profile.statics_file = "generated/sweets.gd"
	profile.statics_const = "Sweets"
	profile.owner_template = read_template()
	profile.seed_template = FileAccess.get_file_as_string(_template_path("sweet_ui_source"))
	profile.member = "_control"
	profile.bases = {"Control": {"class": Templates.CLASS, "factory": Templates.FACTORY, "static": Templates.STATIC}}
	return Generator.new(profile)


## Regenerates every configured target, or only the directory given.
static func generate(only: String = "") -> Error:
	return _report(setup(true, only))


static func _report(result: Dictionary) -> Error:
	return _generator().report(result)


## Enable repairs missing outputs; explicit generation also incorporates source changes.
static func setup(force: bool = false, only: String = "") -> Dictionary:
	register_setting()
	return _generator().setup(force, only)


static func _setup_directory(directory: String, force: bool = false, class_name_: String = DEFAULT_NAME) -> Dictionary:
	return _generator().setup_directory(directory, force, class_name_)


static func _generate_file(target_path: String, source_path: String = SOURCE, classes_path: String = CLASSES_TARGET, sweets_path: String = SWEETS_TARGET, template_source: String = "", class_name_: String = DEFAULT_NAME) -> Dictionary:
	return _generator().generate_file(target_path, source_path, classes_path, sweets_path, template_source, class_name_)


## Clear the returned temporary validation types after their instances are gone.
static func build_candidate(source_path: String = SOURCE, target_path: String = TARGET, classes_path: String = CLASSES_TARGET, sweets_path: String = SWEETS_TARGET, template_source: String = "", class_name_: String = DEFAULT_NAME) -> Dictionary:
	return _generator().build_candidate(source_path, target_path, classes_path, sweets_path, template_source, class_name_)


static func _clear_validation(validation: GDScript) -> Error:
	return _generator().clear_validation(validation)


class Templates:
	const CLASS = \
"class {wrapper} extends RefCounted:
	var _control: {type}
	var _ui:SweetUI

	func node() -> {type}:
		return _control

	func c() -> {type}:
		return _control

	func ui() -> SweetUI:
		return _ui

	func _init(control: {type}) -> void:
		_control = control

	static func _with_parent(control: {type}, parent: Node, ui: SweetUI) -> {wrapper}:
		var wrapper = {wrapper}.new(control)
		parent.add_child(control)
		wrapper._ui = ui
		return wrapper

"
	const API_FUNC = \
"func {factory}(parent: Node = null) -> {wrapper_type}:
	if not is_instance_valid(parent):
		parent = _node
	return {wrapper_type}._with_parent({type}.new(), parent, self)
"
	const API_FROM_FUNC = \
"func {factory}_from(node: {type}, parent: Node = null) -> {wrapper_type}:
	if not is_instance_valid(parent):
		parent = _node
	return {wrapper_type}._with_parent(node, parent, self)
"
	const FACTORY = API_FUNC + "\n\n" + API_FROM_FUNC
	const STATIC = \
"static func {factory}(node: {type} = null) -> {wrapper_type}:
	if node == null:
		node = {type}.new()
	return {wrapper_type}.new(node)
"
